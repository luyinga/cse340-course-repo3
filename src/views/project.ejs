<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <h2>Service Project Details</h2>
        <ul>
            <% if (projectDetails) { %>
                <li>
                    <strong><%= projectDetails.title %></strong> -
                    <%= projectDetails.description %>
                    (Location: <%= projectDetails.location %>, Date: <%= projectDetails.date %>) -
                    <strong>Partner Organization:</strong>
                    <a href="/organization/<%= projectDetails.organization_id %>">
                        <%= projectDetails.organization_name %>
                    </a>
                </li>
            <% } else { %>
                <li>No project details available.</li>
            <% } %>
        </ul>

        <h2>Categories</h2>
        <% if (assignedCategories && assignedCategories.length > 0) { %>
            <ul>
                <% assignedCategories.forEach(category => { %>
                    <li>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.category_name %>
                        </a>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>No categories assigned to this project.</p>
        <% } %>
    </main>
<%- include('partials/footer') %>