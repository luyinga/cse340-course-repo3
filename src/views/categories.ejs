<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <h2>Categories of Service</h2>
        <ul>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <strong><%= category.category_name %></strong>
                    </a>
                    <span> - View Details</span>
                </li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>